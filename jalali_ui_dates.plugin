__id__ = "jalali_ui_dates"
__name__ = "Jalali UI Dates"
__description__ = "Globally replaces all Gregorian dates displayed in the app's UI with Jalali (Shamsi/Persian) dates. Adapts to app language (FA or EN fallback) and handles vague Last Seen statuses."
__author__ = "MSadraShakouri"
__version__ = "1.0.6"
__icon__ = "exteraPlugins/1"
__min_version__ = "12.1.1"

from base_plugin import BasePlugin, MethodHook
from hook_utils import find_class
import time
from datetime import datetime, timedelta

# ==========================================
# Language Strings & Preferences
# ==========================================

class LangStrings:
    def __init__(self, is_fa):
        self.is_fa = is_fa
        
        self.months = [
            "", "فروردین", "اردیبهشت", "خرداد", "تیر", "مرداد", 
            "شهریور", "مهر", "آبان", "آذر", "دی", "بهمن", "اسفند"
        ] if is_fa else [
            "", "Farvardin", "Ordibehesht", "Khordad", "Tir", "Mordad", 
            "Shahrivar", "Mehr", "Aban", "Azar", "Dey", "Bahman", "Esfand"
        ]
        
        self.weekdays = [
            "دوشنبه", "سه‌شنبه", "چهارشنبه", "پنجشنبه", "جمعه", "شنبه", "یکشنبه"
        ] if is_fa else [
            "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"
        ]
        
        self.today = "امروز" if is_fa else "Today"
        self.yesterday = "دیروز" if is_fa else "Yesterday"
        self.at = " در " if is_fa else " at "
        self.last_seen = "آخرین بازدید " if is_fa else "last seen "
        self.joined = "پیوست در " if is_fa else "joined on "
        
        # Vague statuses
        self.a_long_time_ago = "آخرین بازدید خیلی وقت پیش" if is_fa else "last seen a long time ago"
        self.invisible = "نامرئی" if is_fa else "invisible"
        self.lately = "آخرین بازدید اخیراً" if is_fa else "last seen recently"
        self.within_a_week = "آخرین بازدید در این هفته" if is_fa else "last seen within a week"
        self.within_a_month = "آخرین بازدید در این ماه" if is_fa else "last seen within a month"
        self.online = "آنلاین" if is_fa else "online"
        
    def to_digits(self, text: str) -> str:
        if self.is_fa:
            return text.translate(str.maketrans("0123456789", "۰۱۲۳۴۵۶۷۸۹"))
        return text

def is_persian_language():
    try:
        LocaleControllerClass = find_class("org.telegram.messenger.LocaleController")
        locale = LocaleControllerClass.getInstance().getCurrentLocale()
        if locale:
            lang = locale.getLanguage()
            return str(lang).lower() == "fa"
    except:
        pass
    return False

# ==========================================
# Jalali Conversion Logic (No dependencies)
# ==========================================

def to_jalaali(gy, gm, gd):
    gy2 = gy - 1600
    gm2 = gm - 1
    g_day_no = 365 * gy2 + ((gy2 + 3) // 4) - ((gy2 + 99) // 100) + ((gy2 + 399) // 400)
    for i in range(gm2):
        g_day_no += 31 if i in [0, 2, 4, 6, 7, 9, 11] else (29 if i == 1 and ((gy % 4 == 0 and gy % 100 != 0) or gy % 400 == 0) else (28 if i == 1 else 30))
    g_day_no += gd - 1
    j_day_no = g_day_no - 79
    j_np = j_day_no // 12053
    j_day_no %= 12053
    jy = 979 + 33 * j_np + 4 * (j_day_no // 1461)
    j_day_no %= 1461
    if j_day_no >= 366:
        jy += ((j_day_no - 1) // 365)
        j_day_no = (j_day_no - 1) % 365
    if j_day_no < 186:
        jm = j_day_no // 31 + 1
        jd = j_day_no % 31 + 1
    else:
        jm = (j_day_no - 186) // 30 + 7
        jd = (j_day_no - 186) % 30 + 1
    return jy, jm, jd

def get_jalali_from_ts(ts_seconds: int):
    dt = datetime.fromtimestamp(ts_seconds)
    jy, jm, jd = to_jalaali(dt.year, dt.month, dt.day)
    return jy, jm, jd, dt

def get_relative_date_string(jy, jm, jd, strings: LangStrings):
    now = datetime.now()
    njy, njm, njd = to_jalaali(now.year, now.month, now.day)
    if jy == njy and jm == njm and jd == njd:
        return strings.today
    
    yesterday = now - timedelta(days=1)
    y_jy, y_jm, y_jd = to_jalaali(yesterday.year, yesterday.month, yesterday.day)
    if jy == y_jy and jm == y_jm and jd == y_jd:
        return strings.yesterday
    return None

# ==========================================
# Generic Formatters
# ==========================================

def _format_time(dt):
    return f"{dt.hour:02d}:{dt.minute:02d}"

def _format_date_short(jy, jm, jd):
    return f"{jy}/{jm:02d}/{jd:02d}"

def _format_date_long(jy, jm, jd, strings):
    return f"{jd} {strings.months[jm]} {jy}"

def _format_date_no_year(jm, jd, strings):
    return f"{jd} {strings.months[jm]}"

# ==========================================
# Universal Hook Classes
# ==========================================

class UniversalDateHook(MethodHook):
    def __init__(self, plugin, method_name):
        self.plugin = plugin
        self.method_name = method_name

    def before_hooked_method(self, param):
        try:
            if not param.args:
                return
            
            date_ts = int(param.args[0])
            jy, jm, jd, dt = get_jalali_from_ts(date_ts)
            now = datetime.now()
            now_jy, now_jm, now_jd = to_jalaali(now.year, now.month, now.day)
            
            strings = LangStrings(is_persian_language())
            
            time_str = _format_time(dt)
            date_short = _format_date_short(jy, jm, jd)
            date_long = _format_date_long(jy, jm, jd, strings)
            date_no_year = _format_date_no_year(jm, jd, strings)
            rel = get_relative_date_string(jy, jm, jd, strings)
            
            formatted = None

            if self.method_name == "formatDateChat":
                checkYear = bool(param.args[1]) if len(param.args) > 1 else False
                if rel:
                    formatted = rel
                elif jy == now_jy and not checkYear:
                    formatted = date_no_year
                else:
                    formatted = date_long

            elif self.method_name in ("formatDate", "formatDateCallLog"):
                if rel:
                    formatted = rel
                else:
                    formatted = date_short

            elif self.method_name == "formatDateTime":
                formatted = f"{date_short} {time_str}"

            elif self.method_name == "formatDateOnline":
                made_shorter = param.args[1] if len(param.args) > 1 else None
                ls_cap = strings.last_seen.capitalize() if not strings.is_fa else strings.last_seen
                
                if rel == strings.today:
                    formatted = f"{ls_cap}{strings.today.lower()}{strings.at}{time_str}"
                elif rel == strings.yesterday:
                    if made_shorter is not None:
                        try:
                            made_shorter[0] = True
                        except:
                            pass
                    formatted = f"{ls_cap}{strings.yesterday.lower()}{strings.at}{time_str}"
                else:
                    formatted = f"{ls_cap}{date_short}{strings.at}{time_str}"

            elif self.method_name == "formatDateAudio":
                if rel == strings.today:
                    formatted = f"{strings.today}{strings.at}{time_str}"
                elif rel == strings.yesterday:
                    formatted = f"{strings.yesterday}{strings.at}{time_str}"
                else:
                    formatted = f"{date_short}{strings.at}{time_str}"

            elif self.method_name == "formatDateForBan":
                formatted = date_long

            elif self.method_name == "stringForMessageListDate":
                day_diff = dt.toordinal() - now.toordinal()
                if day_diff == 0 or (day_diff == -1 and (time.time() - date_ts) < 8 * 3600):
                    formatted = time_str
                elif -7 < day_diff <= -1:
                    formatted = strings.weekdays[dt.weekday()]
                elif jy == now_jy:
                    formatted = date_no_year
                else:
                    formatted = date_short

            elif self.method_name in ("formatSeenDate", "formatStatusExpireDateTime", "formatLocationUpdateDate", "formatStartsTime"):
                if self.method_name == "formatStartsTime" and not rel:
                    formatted = f"{date_no_year}{strings.at}{time_str}"
                else:
                    if rel == strings.today:
                        formatted = f"{strings.today}{strings.at}{time_str}"
                    elif rel == strings.yesterday:
                        formatted = f"{strings.yesterday}{strings.at}{time_str}"
                    else:
                        formatted = f"{date_short}{strings.at}{time_str}"

            elif self.method_name == "formatSectionDate":
                if jy == now_jy:
                    formatted = strings.months[jm]
                else:
                    formatted = f"{strings.months[jm]} {jy}"

            elif self.method_name == "formatYearMont":
                always_show_year = bool(param.args[1]) if len(param.args) > 1 else False
                if not always_show_year and jy == now_jy:
                    formatted = strings.months[jm]
                else:
                    formatted = f"{strings.months[jm]} {jy}"

            elif self.method_name == "formatJoined":
                j_cap = strings.joined.capitalize() if not strings.is_fa else strings.joined
                formatted = f"{j_cap}{date_long}"
                
            elif self.method_name == "formatImportedDate":
                formatted = f"{date_long}, {time_str}"

            if formatted:
                param.setResult(strings.to_digits(formatted))
                
        except Exception as e:
            self.plugin.log(f"Err in {self.method_name}: {e}")

class FormatUserStatusHook(MethodHook):
    def __init__(self, plugin):
        self.plugin = plugin
        
    def after_hooked_method(self, param):
        try:
            res = param.getResult()
            if not res or not isinstance(res, str):
                return
            
            user = param.args[1] if len(param.args) > 1 else None
            strings = LangStrings(is_persian_language())
            
            if not user:
                param.setResult(strings.to_digits(strings.a_long_time_ago))
                return
                
            status = getattr(user, "status", None)
            if not status:
                param.setResult(strings.to_digits(strings.a_long_time_ago))
                return
                
            expires = getattr(status, "expires", 0)
            
            if expires == 0:
                param.setResult(strings.to_digits(strings.a_long_time_ago))
            elif expires == -1:
                param.setResult(strings.to_digits(strings.invisible))
            elif expires == -100:
                param.setResult(strings.to_digits(strings.lately))
            elif expires == -101:
                param.setResult(strings.to_digits(strings.within_a_week))
            elif expires == -102:
                param.setResult(strings.to_digits(strings.within_a_month))
            elif expires > 0:
                # Differentiate between an exact date and "Online"
                has_digit = any(c.isdigit() or c in "۰۱۲۳۴۵۶۷۸۹" for c in res)
                if not has_digit:
                    # If it has no digits, it must be the "Online" string because our formatDateOnline hook ALWAYS outputs digits (e.g., time)
                    param.setResult(strings.to_digits(strings.online))
                    
        except Exception as e:
            self.plugin.log(f"Err in formatUserStatus: {e}")

# ==========================================
# Plugin Registration
# ==========================================

class JalaliDatesPlugin(BasePlugin):
    def on_plugin_load(self):
        self.log("Initializing Jalali Dates Hooks 1.0.5 by MSadraShakouri...")
        try:
            LocaleControllerClass = find_class("org.telegram.messenger.LocaleController")
            
            methods_to_hook = [
                "formatDateChat", "formatDate", "formatDateTime", 
                "formatDateOnline", "formatDateAudio", "formatDateForBan", 
                "formatDateCallLog", "stringForMessageListDate",
                "formatSeenDate", "formatStatusExpireDateTime",
                "formatLocationUpdateDate", "formatStartsTime",
                "formatSectionDate", "formatYearMont", "formatJoined",
                "formatImportedDate"
            ]
            
            for method in methods_to_hook:
                try:
                    self.hook_all_methods(LocaleControllerClass, method, UniversalDateHook(self, method))
                except Exception as ex:
                    self.log(f"Could not hook {method}: {ex}")
            
            # Hook the vague User Status method
            try:
                self.hook_all_methods(LocaleControllerClass, "formatUserStatus", FormatUserStatusHook(self))
            except Exception as ex:
                self.log(f"Could not hook formatUserStatus: {ex}")
            
            self.log("All Jalali Hooks registered successfully!")
        except Exception as e:
            self.log(f"Failed to load hooks: {e}")
