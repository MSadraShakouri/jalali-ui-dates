class LangStrings:
    def __init__(self, language="en", region="", script=""):
        self.language = str(language).lower()
        self.region = str(region).upper()
        self.script = str(script).lower()
        if self.language in ("prs", "per", "fas"):
            self.language = "fa"
        elif self.language == "ku":
            if self.script in ("arab", "adlm") or self.region in ("IR", "IQ"):
                self.language = "ckb"
            else:
                self.language = "kmr"

        self.is_fa = self.language == "fa"
        self.is_zh = self.language == "zh"
        self.is_zh_traditional = self.is_zh and (
            self.script == "hant" or self.region in ("TW", "HK", "MO")
        )
        self.numeric_dates = False
        self.digit_translation = None

        if self.is_fa:
            self.months = [
                "", "فروردین", "اردیبهشت", "خرداد", "تیر", "مرداد",
                "شهریور", "مهر", "آبان", "آذر", "دی", "بهمن", "اسفند"
            ]
            self.weekdays = [
                "دوشنبه", "سه‌شنبه", "چهارشنبه", "پنجشنبه", "جمعه", "شنبه", "یکشنبه"
            ]
            self.today = "امروز"
            self.yesterday = "دیروز"
            self.at = " در "
            self.last_seen = "آخرین بازدید "
            self.joined = "پیوست در "
            self.imported_separator = ", "
            self.digit_translation = str.maketrans("0123456789", "۰۱۲۳۴۵۶۷۸۹")
        elif self.is_zh:
            self.months = [
                "", "1月", "2月", "3月", "4月", "5月", "6月",
                "7月", "8月", "9月", "10月", "11月", "12月"
            ]
            self.weekdays = [
                "星期一", "星期二", "星期三", "星期四", "星期五", "星期六", "星期日"
            ]
            self.today = "今天"
            self.yesterday = "昨天"
            if self.is_zh_traditional:
                self.last_seen = "最後上線於"
                self.joined = "加入於"
            else:
                self.last_seen = "最后上线于"
                self.joined = "加入于"
            self.at = " "
            self.imported_separator = "，"
        elif self.language in REGIONAL_LANGUAGE_STRINGS:
            localized = REGIONAL_LANGUAGE_STRINGS[self.language]
            self.months = [""] + [f"{month:02d}" for month in range(1, 13)]
            self.weekdays = localized["weekdays"]
            self.today = localized["today"]
            self.yesterday = localized["yesterday"]
            self.at = localized["at"]
            self.last_seen = localized["last_seen"]
            self.joined = localized["joined"]
            self.imported_separator = localized["imported_separator"]
            self.numeric_dates = True
            if localized.get("digits"):
                self.digit_translation = str.maketrans("0123456789", localized["digits"])
        else:
            self.months = [
                "", "Farvardin", "Ordibehesht", "Khordad", "Tir", "Mordad",
                "Shahrivar", "Mehr", "Aban", "Azar", "Dey", "Bahman", "Esfand"
            ]
            self.weekdays = [
                "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"
            ]
            self.today = "Today"
            self.yesterday = "Yesterday"
            self.at = " at "
            self.last_seen = "last seen "
            self.joined = "joined on "
            self.imported_separator = ", "

    def to_digits(self, text: str) -> str:
        if self.digit_translation:
            return text.translate(self.digit_translation)
        return text


def get_current_locale_parts():
    try:
        LocaleControllerClass = find_class("org.telegram.messenger.LocaleController")
        locale = LocaleControllerClass.getInstance().getCurrentLocale()
        if locale:
            language = str(locale.getLanguage()).lower()
            region = ""
            script = ""
            try:
                region = str(locale.getCountry()).upper()
            except:
                pass
            try:
                script = str(locale.getScript()).lower()
            except:
                pass
            # Be tolerant of locale implementations that return a full tag
            # from getLanguage() rather than just the language component.
            if "-" in language or "_" in language:
                parts = language.replace("_", "-").split("-")
                language = parts[0]
                for part in parts[1:]:
                    if len(part) == 4 and not script:
                        script = part.lower()
                    elif len(part) == 2 and not region:
                        region = part.upper()
            return language, region, script
    except:
        pass
    return "en", "", ""


def get_lang_strings():
    return LangStrings(*get_current_locale_parts())

# ==========================================
# Jalali Conversion Logic (No dependencies)
# ==========================================

def to_jalaali(gy, gm, gd):
    gy2 = gy - 1600
    gm2 = gm - 1
    g_day_no = 365 * gy2 + ((gy2 + 3) // 4) - ((gy2 + 99) // 100) + ((gy2 + 399) // 400)
    for i in range(gm2):
        g_day_no += 31 if i in [0, 2, 4, 6, 7, 9, 11] else (29 if i == 1 and ((gy % 4 == 0 and gy % 100 != 0) or gy % 400 == 0) else (28 if i == 1 else 30))
    g_day_no += gd - 1
    j_day_no = g_day_no - 79
    j_np = j_day_no // 12053
    j_day_no %= 12053
    jy = 979 + 33 * j_np + 4 * (j_day_no // 1461)
    j_day_no %= 1461
    if j_day_no >= 366:
        jy += ((j_day_no - 1) // 365)
        j_day_no = (j_day_no - 1) % 365
    if j_day_no < 186:
        jm = j_day_no // 31 + 1
        jd = j_day_no % 31 + 1
    else:
        jm = (j_day_no - 186) // 30 + 7
        jd = (j_day_no - 186) % 30 + 1
    return jy, jm, jd


def get_jalali_from_ts(ts_seconds: int):
    dt = datetime.fromtimestamp(ts_seconds)
    jy, jm, jd = to_jalaali(dt.year, dt.month, dt.day)
    return jy, jm, jd, dt


def get_relative_date_string(jy, jm, jd, strings):
    now = datetime.now()
    njy, njm, njd = to_jalaali(now.year, now.month, now.day)
    if jy == njy and jm == njm and jd == njd:
        return strings.today

    yesterday = now - timedelta(days=1)
    y_jy, y_jm, y_jd = to_jalaali(yesterday.year, yesterday.month, yesterday.day)
    if jy == y_jy and jm == y_jm and jd == y_jd:
        return strings.yesterday
    return None

# ==========================================
# Generic Formatters
# ==========================================

def _format_time(dt):
    return f"{dt.hour:02d}:{dt.minute:02d}"


def _format_date_short(jy, jm, jd, strings):
    if strings.is_zh:
        return f"{jy}年{strings.months[jm]}{jd}日"
    return f"{jy}/{jm:02d}/{jd:02d}"


def _format_date_long(jy, jm, jd, strings):
    if strings.is_zh:
        return f"{jy}年{strings.months[jm]}{jd}日"
    if strings.numeric_dates:
        return _format_date_short(jy, jm, jd, strings)
    return f"{jd} {strings.months[jm]} {jy}"


def _format_date_no_year(jm, jd, strings):
    if strings.is_zh:
        return f"{strings.months[jm]}{jd}日"
    if strings.numeric_dates:
        return f"{jm:02d}/{jd:02d}"
    return f"{jd} {strings.months[jm]}"


def _format_month_year(jy, jm, strings, include_year=True):
    if strings.is_zh:
        if include_year:
            return f"{jy}年{strings.months[jm]}"
        return strings.months[jm]
    if strings.numeric_dates:
        if include_year:
            return f"{jy}/{jm:02d}"
        return f"{jm:02d}"
    if include_year:
        return f"{strings.months[jm]} {jy}"
    return strings.months[jm]

# ==========================================
# Universal Hook Classes
# ==========================================

class UniversalDateHook(MethodHook):
    def __init__(self, plugin, method_name):
        self.plugin = plugin
        self.method_name = method_name

    def before_hooked_method(self, param):
        try:
            if not param.args:
                return

            date_ts = int(param.args[0])
            jy, jm, jd, dt = get_jalali_from_ts(date_ts)
            now = datetime.now()
            now_jy = to_jalaali(now.year, now.month, now.day)[0]

            strings = get_lang_strings()

            time_str = _format_time(dt)
            date_short = _format_date_short(jy, jm, jd, strings)
            date_long = _format_date_long(jy, jm, jd, strings)
            date_no_year = _format_date_no_year(jm, jd, strings)
            rel = get_relative_date_string(jy, jm, jd, strings)
            formatted = None

            if self.method_name == "formatDateChat":
                check_year = bool(param.args[1]) if len(param.args) > 1 else False
                if rel:
                    formatted = rel
                elif jy == now_jy and not check_year:
                    formatted = date_no_year
                else:
                    formatted = date_long

            elif self.method_name in ("formatDate", "formatDateCallLog"):
                if rel:
                    formatted = rel
                else:
                    formatted = date_short

            elif self.method_name == "formatDateTime":
                formatted = f"{date_short} {time_str}"

            elif self.method_name == "formatDateOnline":
                made_shorter = param.args[1] if len(param.args) > 1 else None
                last_seen = strings.last_seen
                if not strings.is_fa:
                    last_seen = last_seen.capitalize()
                if rel == strings.today:
                    formatted = f"{last_seen}{strings.today.lower()}{strings.at}{time_str}"
                elif rel == strings.yesterday:
                    if made_shorter is not None:
                        try:
                            made_shorter[0] = True
                        except:
                            pass
                    formatted = f"{last_seen}{strings.yesterday.lower()}{strings.at}{time_str}"
                else:
                    formatted = f"{last_seen}{date_short}{strings.at}{time_str}"

            elif self.method_name == "formatDateAudio":
                if rel == strings.today:
                    formatted = f"{strings.today}{strings.at}{time_str}"
                elif rel == strings.yesterday:
                    formatted = f"{strings.yesterday}{strings.at}{time_str}"
                else:
                    formatted = f"{date_short}{strings.at}{time_str}"

            elif self.method_name == "formatDateForBan":
                formatted = date_long

            elif self.method_name == "stringForMessageListDate":
                day_diff = dt.toordinal() - now.toordinal()
                if day_diff == 0 or (day_diff == -1 and (time.time() - date_ts) < 8 * 3600):
                    formatted = time_str
                elif -7 < day_diff <= -1:
                    formatted = strings.weekdays[dt.weekday()]
                elif jy == now_jy:
                    formatted = date_no_year
                else:
                    formatted = date_short

            elif self.method_name in ("formatSeenDate", "formatStatusExpireDateTime", "formatLocationUpdateDate", "formatStartsTime"):
                if self.method_name == "formatStartsTime" and not rel:
                    formatted = f"{date_no_year}{strings.at}{time_str}"
                else:
                    if rel == strings.today:
                        formatted = f"{strings.today}{strings.at}{time_str}"
                    elif rel == strings.yesterday:
                        formatted = f"{strings.yesterday}{strings.at}{time_str}"
                    else:
                        formatted = f"{date_short}{strings.at}{time_str}"

            elif self.method_name == "formatSectionDate":
                formatted = _format_month_year(jy, jm, strings, jy != now_jy)

            elif self.method_name == "formatYearMont":
                always_show_year = bool(param.args[1]) if len(param.args) > 1 else False
                formatted = _format_month_year(jy, jm, strings, always_show_year or jy != now_jy)

            elif self.method_name == "formatJoined":
                joined = strings.joined
                if not strings.is_fa and not strings.is_zh:
                    joined = joined.capitalize()
                formatted = f"{joined}{date_long}"

            elif self.method_name == "formatImportedDate":
                formatted = f"{date_long}{strings.imported_separator}{time_str}"

            if formatted:
                param.setResult(strings.to_digits(formatted))

        except Exception as e:
            self.plugin.log(f"Err in {self.method_name}: {e}")


# ==========================================
# Plugin Registration
# ==========================================

class JalaliDatesPlugin(BasePlugin):
    def on_plugin_load(self):
        self.log("Initializing Jalali Dates Hooks 1.0.9 by MSadraShakouri...")
        try:
            LocaleControllerClass = find_class("org.telegram.messenger.LocaleController")

            methods_to_hook = [
                "formatDateChat", "formatDate", "formatDateTime",
                "formatDateOnline", "formatDateAudio", "formatDateForBan",
                "formatDateCallLog", "stringForMessageListDate",
                "formatSeenDate", "formatStatusExpireDateTime",
                "formatLocationUpdateDate", "formatStartsTime",
                "formatSectionDate", "formatYearMont", "formatJoined",
                "formatImportedDate"
            ]

            for method in methods_to_hook:
                try:
                    self.hook_all_methods(LocaleControllerClass, method, UniversalDateHook(self, method))
                except Exception as ex:
                    self.log(f"Could not hook {method}: {ex}")

            # Leave formatUserStatus untouched so Telegram keeps its native,
            # localized wording for vague last-seen ranges.
            self.log("All Jalali Hooks registered successfully!")
        except Exception as e:
            self.log(f"Failed to load hooks: {e}")
