__id__ = "jalali_ui_dates"
__name__ = "Jalali UI Dates"
__description__ = "Localized Jalali dates for Persian, Chinese, and regional languages; preserves Telegram's native vague status text."
__author__ = "MSadraShakouri"
__version__ = "1.0.9"
__icon__ = "exteraPlugins/1"
__min_version__ = "12.1.1"

from base_plugin import BasePlugin, MethodHook
from hook_utils import find_class
import time
from datetime import datetime, timedelta

